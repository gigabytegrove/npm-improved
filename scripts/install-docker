#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${ROOT_DIR}"

usage() {
	cat <<'EOF'
Usage:
  ./scripts/install-docker [sqlite|mysql|postgres] [--check-only] [--auto-ports] [--clean-build]

Examples:
  ./scripts/install-docker
  ./scripts/install-docker sqlite
  ./scripts/install-docker mysql
  ./scripts/install-docker postgres
  ./scripts/install-docker sqlite --check-only
  ./scripts/install-docker sqlite --auto-ports
  ./scripts/install-docker sqlite --clean-build

The installer creates .env from .env.example when needed, validates Docker
Compose, checks host port availability, builds the current checkout, and
force-recreates only the NPM Improved application container. Existing
database and persistent data are preserved.

A running NPM Improved app is recognized as the instance being updated, so
its own published ports are not considered conflicts. Use --auto-ports only
when another service owns a requested host port. Use --clean-build to disable
Docker layer reuse. Every successful install verifies the live app identity.
EOF
}

MODE="sqlite"
CHECK_ONLY=0
AUTO_PORTS=0
CLEAN_BUILD=0

for arg in "$@"; do
	case "$arg" in
		sqlite|mysql|postgres)
			MODE="$arg"
			;;
		--check-only)
			CHECK_ONLY=1
			;;
		--auto-ports)
			AUTO_PORTS=1
			;;
		--clean-build)
			CLEAN_BUILD=1
			;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			echo "ERROR: Unknown argument: $arg" >&2
			usage >&2
			exit 2
			;;
	esac
done

case "$MODE" in
	sqlite) COMPOSE_FILE="compose.yaml" ;;
	mysql) COMPOSE_FILE="compose.mysql.yaml" ;;
	postgres) COMPOSE_FILE="compose.postgres.yaml" ;;
esac

if ! command -v docker >/dev/null 2>&1; then
	echo "ERROR: docker is not installed or is not in PATH." >&2
	exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
	echo "ERROR: Docker Compose v2 is required ('docker compose')." >&2
	exit 1
fi

if ! docker info >/dev/null 2>&1; then
	echo "ERROR: Docker daemon is not reachable for the current user." >&2
	exit 1
fi

if [ ! -f ".env" ]; then
	cp .env.example .env
	echo "Created .env from .env.example"
fi

compose=(docker compose -f "$COMPOSE_FILE")

SOURCE_VERSION="local"
if [ -f ".version" ]; then
	SOURCE_VERSION="$(tr -d '[:space:]' < .version)"
fi
if [ -z "$SOURCE_VERSION" ]; then
	SOURCE_VERSION="local"
fi

SOURCE_COMMIT="unknown"
if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
	SOURCE_COMMIT="$(git rev-parse --short=12 HEAD)"
	if ! git diff --quiet --ignore-submodules -- || ! git diff --cached --quiet --ignore-submodules --; then
		SOURCE_COMMIT="${SOURCE_COMMIT}-dirty"
	fi
fi

BUILD_DATE="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
export NPM_BUILD_VERSION="$SOURCE_VERSION"
export NPM_BUILD_COMMIT="$SOURCE_COMMIT"
export NPM_BUILD_DATE="$BUILD_DATE"

CURRENT_APP_ID="$("${compose[@]}" ps -q app 2>/dev/null || true)"
CURRENT_APP_SHORT=""
if [ -n "$CURRENT_APP_ID" ]; then
	CURRENT_APP_SHORT="${CURRENT_APP_ID:0:12}"
	echo "Existing NPM Improved app detected: ${CURRENT_APP_SHORT}"
	echo "Its published ports are eligible for in-place replacement."
fi

read_env() {
	local key="$1"
	local fallback="$2"
	local raw=""

	raw="$(awk -F= -v k="$key" '$1 == k {sub(/^[^=]*=/, ""); print; found=1} END {if (!found) exit 0}' .env | tail -n 1)"
	raw="${raw%$'\r'}"

	if [[ "$raw" == \"*\" && "$raw" == *\" ]]; then
		raw="${raw:1:${#raw}-2}"
	elif [[ "$raw" == \'*\' && "$raw" == *\' ]]; then
		raw="${raw:1:${#raw}-2}"
	fi

	if [ -z "$raw" ]; then
		raw="$fallback"
	fi

	printf '%s' "$raw"
}

validate_port() {
	local label="$1"
	local port="$2"

	if ! [[ "$port" =~ ^[0-9]+$ ]] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
		echo "ERROR: ${label} must be a TCP port from 1 to 65535; got '${port}'." >&2
		exit 1
	fi
}

docker_port_owners() {
	local port="$1"
	docker ps --format '{{.ID}}\t{{.Ports}}' 2>/dev/null | awk -v p="$port" '
		index($0, ":" p "->") { print $1 }
	'
}

port_in_use() {
	local port="$1"
	local owners=""
	local owner=""
	local has_current_owner=0

	owners="$(docker_port_owners "$port")"
	if [ -n "$owners" ]; then
		while IFS= read -r owner; do
			[ -z "$owner" ] && continue
			if [ -n "$CURRENT_APP_SHORT" ] && [ "$owner" = "$CURRENT_APP_SHORT" ]; then
				has_current_owner=1
				continue
			fi
			return 0
		done <<< "$owners"

		if [ "$has_current_owner" -eq 1 ]; then
			return 1
		fi
	fi

	if command -v ss >/dev/null 2>&1; then
		ss -H -ltn 2>/dev/null | awk -v p="$port" '
			{
				addr=$4
				sub(/^.*:/, "", addr)
				gsub(/\]/, "", addr)
				if (addr == p) {
					found=1
					exit
				}
			}
			END { exit found ? 0 : 1 }
		'
		return
	fi

	if command -v netstat >/dev/null 2>&1; then
		netstat -ltn 2>/dev/null | awk -v p="$port" '
			NR > 2 {
				addr=$4
				sub(/^.*:/, "", addr)
				if (addr == p) {
					found=1
					exit
				}
			}
			END { exit found ? 0 : 1 }
		'
		return
	fi

	[ -n "$(docker_port_owners "$port")" ]
}
show_port_owner() {
	local port="$1"

	if command -v ss >/dev/null 2>&1; then
		ss -H -ltnp 2>/dev/null | awk -v p="$port" '
			{
				addr=$4
				test=addr
				sub(/^.*:/, "", test)
				gsub(/\]/, "", test)
				if (test == p) print
			}
		' || true
	fi

	docker ps --format '  {{.Names}}\t{{.Ports}}' 2>/dev/null 		| grep -E "(:|^)${port}->|0\.0\.0\.0:${port}|\[::\]:${port}" || true
}

set_env() {
	local key="$1"
	local value="$2"

	if grep -q "^${key}=" .env; then
		sed -i "s|^${key}=.*|${key}=${value}|" .env
	else
		printf '%s=%s\n' "$key" "$value" >> .env
	fi
}

# Persist the host deployment location and database mode so the authenticated
# Settings -> Update manager can launch a temporary self-cleaning handoff.
# Existing NPM_IMAGE selections are preserved; first-time/source deployments
# default to the locally built image.
set_env NPM_HOST_PROJECT_DIR "$ROOT_DIR"
set_env NPM_DEPLOYMENT_MODE "$MODE"
# Running the source installer intentionally returns the application service
# to the locally built image. The UI updater changes NPM_IMAGE to an official
# stable GHCR image only when a managed update is installed.
set_env NPM_IMAGE "npm-improved:local"

find_free_port() {
	local candidate="$1"
	shift
	local taken
	local reserved

	while [ "$candidate" -le 65535 ]; do
		reserved=0
		for taken in "$@"; do
			if [ "$candidate" = "$taken" ]; then
				reserved=1
				break
			fi
		done

		if [ "$reserved" -eq 0 ] && ! port_in_use "$candidate"; then
			printf '%s' "$candidate"
			return 0
		fi

		candidate=$((candidate + 1))
	done

	return 1
}

choose_available_ports() {
	local reserved=()

	SUGGEST_HTTP="$HTTP_PORT"
	SUGGEST_ADMIN="$ADMIN_PORT"
	SUGGEST_HTTPS="$HTTPS_PORT"

	if ! port_in_use "$HTTP_PORT"; then reserved+=("$HTTP_PORT"); fi
	if ! port_in_use "$ADMIN_PORT"; then reserved+=("$ADMIN_PORT"); fi
	if ! port_in_use "$HTTPS_PORT"; then reserved+=("$HTTPS_PORT"); fi

	if port_in_use "$HTTP_PORT"; then
		SUGGEST_HTTP="$(find_free_port 8080 "${reserved[@]}")" || return 1
		reserved+=("$SUGGEST_HTTP")
	fi

	if port_in_use "$ADMIN_PORT"; then
		SUGGEST_ADMIN="$(find_free_port 8181 "${reserved[@]}")" || return 1
		reserved+=("$SUGGEST_ADMIN")
	fi

	if port_in_use "$HTTPS_PORT"; then
		SUGGEST_HTTPS="$(find_free_port 8443 "${reserved[@]}")" || return 1
		reserved+=("$SUGGEST_HTTPS")
	fi
}
HTTP_PORT="$(read_env HTTP_PORT 80)"
ADMIN_PORT="$(read_env ADMIN_PORT 81)"
HTTPS_PORT="$(read_env HTTPS_PORT 443)"

validate_port HTTP_PORT "$HTTP_PORT"
validate_port ADMIN_PORT "$ADMIN_PORT"
validate_port HTTPS_PORT "$HTTPS_PORT"

if [ "$HTTP_PORT" = "$ADMIN_PORT" ] || [ "$HTTP_PORT" = "$HTTPS_PORT" ] || [ "$ADMIN_PORT" = "$HTTPS_PORT" ]; then
	echo "ERROR: HTTP_PORT, ADMIN_PORT, and HTTPS_PORT must be unique host ports." >&2
	exit 1
fi

conflicts=0
for entry in "HTTP_PORT:$HTTP_PORT" "ADMIN_PORT:$ADMIN_PORT" "HTTPS_PORT:$HTTPS_PORT"; do
	label="${entry%%:*}"
	port="${entry##*:}"

	if port_in_use "$port"; then
		echo "ERROR: ${label}=${port} is already in use on this host." >&2
		show_port_owner "$port" >&2
		conflicts=1
	fi
done

if [ "$conflicts" -ne 0 ]; then
	if ! choose_available_ports; then
		echo "ERROR: Could not find a complete set of free alternative host ports." >&2
		exit 2
	fi

	if [ "$AUTO_PORTS" -eq 1 ]; then
		echo
		echo "Occupied host ports detected. Applying free host-side mappings:"
		echo "  HTTP_PORT=$SUGGEST_HTTP"
		echo "  ADMIN_PORT=$SUGGEST_ADMIN"
		echo "  HTTPS_PORT=$SUGGEST_HTTPS"

		set_env HTTP_PORT "$SUGGEST_HTTP"
		set_env ADMIN_PORT "$SUGGEST_ADMIN"
		set_env HTTPS_PORT "$SUGGEST_HTTPS"

		HTTP_PORT="$SUGGEST_HTTP"
		ADMIN_PORT="$SUGGEST_ADMIN"
		HTTPS_PORT="$SUGGEST_HTTPS"
	else
		cat >&2 <<EOF

NPM Improved was not started because one or more host ports are occupied.

Free host-side mappings detected on this machine:

  HTTP_PORT=$SUGGEST_HTTP
  ADMIN_PORT=$SUGGEST_ADMIN
  HTTPS_PORT=$SUGGEST_HTTPS

To apply those ports automatically and continue:

  ./scripts/install-docker $MODE --auto-ports

Or edit .env manually and rerun the installer.

If NPM Improved is replacing the service that owns 80/81/443, stop that service
deliberately first. The installer will never stop an existing service for you.
EOF
		exit 2
	fi
fi

echo "Validating ${COMPOSE_FILE} ..."
"${compose[@]}" config --quiet

echo
echo "Source identity:"
echo "  Version: $SOURCE_VERSION"
echo "  Commit:  $SOURCE_COMMIT"
echo "  Built:   $BUILD_DATE"

if [ "$CHECK_ONLY" -eq 1 ]; then
	echo "Docker preflight passed for ${MODE}."
	exit 0
fi

echo
if [ "$CLEAN_BUILD" -eq 1 ]; then
	echo "Building NPM Improved without Docker layer cache ..."
	"${compose[@]}" build --pull --no-cache app
else
	echo "Building NPM Improved ..."
	"${compose[@]}" build --pull app
fi

if [ "$MODE" != "sqlite" ]; then
	echo "Ensuring database service is running ..."
	"${compose[@]}" up -d --no-build db
fi

echo "Replacing NPM Improved application container ..."
"${compose[@]}" up -d --no-build --no-deps --force-recreate app

container_id="$("${compose[@]}" ps -q app)"
if [ -z "$container_id" ]; then
	echo "ERROR: NPM Improved application container was not created." >&2
	"${compose[@]}" ps >&2 || true
	exit 1
fi

healthy=0
for _ in $(seq 1 60); do
	state="$(docker inspect --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' "$container_id" 2>/dev/null || true)"

	case "$state" in
		*" healthy")
			healthy=1
			break
			;;
		exited*|dead*)
			echo "ERROR: NPM Improved exited before becoming healthy." >&2
			"${compose[@]}" logs --tail=200 app >&2 || true
			exit 1
			;;
	esac

	sleep 2
done

if [ "$healthy" -ne 1 ]; then
	echo "ERROR: NPM Improved did not become healthy within the startup window." >&2
	"${compose[@]}" ps >&2 || true
	"${compose[@]}" logs --tail=200 app >&2 || true
	exit 1
fi

runtime_backend_name="$(docker exec "$container_id" jq -r '.name // empty' /app/package.json 2>/dev/null || true)"
runtime_backend_version="$(docker exec "$container_id" jq -r '.version // empty' /app/package.json 2>/dev/null || true)"
runtime_build_version="$(docker exec "$container_id" sh -c 'printf "%s" "$NPM_BUILD_VERSION"' 2>/dev/null || true)"
runtime_build_commit="$(docker exec "$container_id" sh -c 'printf "%s" "$NPM_BUILD_COMMIT"' 2>/dev/null || true)"

verification_failed=0
if ! docker exec "$container_id" grep -Fq '<title>NPM Improved</title>' /app/frontend/index.html; then
	echo "ERROR: Live container frontend is not the NPM Improved build." >&2
	verification_failed=1
fi
if [ "$runtime_backend_name" != "npm-improved-backend" ]; then
	echo "ERROR: Live container backend identity is '${runtime_backend_name:-missing}', expected 'npm-improved-backend'." >&2
	verification_failed=1
fi
if [ "$runtime_build_version" != "$SOURCE_VERSION" ]; then
	echo "ERROR: Live container build version '${runtime_build_version:-missing}' does not match source '$SOURCE_VERSION'." >&2
	verification_failed=1
fi
if [ "$runtime_build_commit" != "$SOURCE_COMMIT" ]; then
	echo "ERROR: Live container build commit '${runtime_build_commit:-missing}' does not match source '$SOURCE_COMMIT'." >&2
	verification_failed=1
fi
if [ "$verification_failed" -ne 0 ]; then
	echo "ERROR: Runtime verification failed; refusing to report the update as successful." >&2
	"${compose[@]}" ps >&2 || true
	exit 1
fi

echo
echo "NPM Improved is healthy and runtime verification passed."
echo "Management UI: http://<host>:${ADMIN_PORT}"
echo
echo "Live build evidence:"
echo "  Frontend: NPM Improved"
echo "  Backend:  ${runtime_backend_name} ${runtime_backend_version}"
echo "  Version:  ${runtime_build_version}"
echo "  Commit:   ${runtime_build_commit}"
echo
"${compose[@]}" ps
