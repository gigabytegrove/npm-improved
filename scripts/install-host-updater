#!/usr/bin/env bash
# Host-owned native updater bootstrap/upgrade. No updater containers.
set -Eeuo pipefail
umask 022

[ "$(id -u)" -eq 0 ] || { echo "Run NPMi's installer with host root privileges." >&2; exit 1; }
for command in systemctl python3 docker sha256sum; do
  command -v "$command" >/dev/null || { echo "Missing required host command: $command" >&2; exit 1; }
done
docker compose version >/dev/null || { echo "Docker Compose v2 required." >&2; exit 1; }
[ -d /run/systemd/system ] || { echo "systemd is required for the native updater." >&2; exit 1; }

SOURCE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(realpath "${1:-$SOURCE/..}")"
if [[ ! "$ROOT" =~ ^/[a-zA-Z0-9._/-]+$ || "$ROOT" == *".."* ]]; then
  echo "Unsafe installation path." >&2; exit 1
fi
[ -f "$ROOT/.env" ] && [ -d "$ROOT/data" ] || {
  echo "Expected the existing NPMi .env and data directory in $ROOT." >&2; exit 1;
}
VERSION="$(tr -d '[:space:]' < "$SOURCE/../.version")"
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  echo "The updater package must have a stable version." >&2; exit 1;
}
ID="$(printf '%s' "$ROOT" | sha256sum | cut -c1-12)"
UNIT="npm-improved-update-$ID"
BIN="/usr/local/libexec/npm-improved/$ID"

# Each installation gets its own root-owned programs. Multiple deployments
# on a shared Docker host never overwrite each other's update executors.
install -d -m 0755 "$BIN"
for name in update-handoff.sh host-update-dispatch.py host-update-maintenance.py; do
  [ -f "$SOURCE/$name" ] || { echo "Missing trusted host program $name" >&2; exit 1; }
  tempfile="$(mktemp "$BIN/.new-program-XXXXXXXX")"
  install -m 0755 "$SOURCE/$name" "$tempfile"
  mv -f "$tempfile" "$BIN/$name"
done

cat >"/etc/systemd/system/$UNIT.service" <<EOF
[Unit]
Description=NPM Improved native in-place updater ($ROOT)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=$ROOT
ExecStart=$BIN/host-update-dispatch.py $ROOT
TimeoutStartSec=0
UMask=0077
EOF

cat >"/etc/systemd/system/$UNIT.path" <<EOF
[Unit]
Description=NPM Improved native updater request watcher ($ROOT)

[Path]
PathExists=$ROOT/data/host-update-request.json
Unit=$UNIT.service

[Install]
WantedBy=multi-user.target
EOF

cat >"/etc/systemd/system/$UNIT-maintenance.service" <<EOF
[Unit]
Description=NPM Improved automatic host updater maintenance ($ROOT)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=$ROOT
ExecStart=$BIN/host-update-maintenance.py $ROOT
TimeoutStartSec=120
UMask=0077
EOF

cat >"/etc/systemd/system/$UNIT-maintenance.timer" <<EOF
[Unit]
Description=Check NPM Improved native updater version ($ROOT)

[Timer]
OnBootSec=5min
OnUnitActiveSec=6h
Persistent=true
Unit=$UNIT-maintenance.service

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now "$UNIT.path" "$UNIT-maintenance.timer"
systemctl is-active --quiet "$UNIT.path" || {
  echo "The native NPMi updater service failed to activate." >&2; exit 1;
}
systemctl is-active --quiet "$UNIT-maintenance.timer" || {
  echo "The native NPMi updater maintenance timer failed to activate." >&2; exit 1;
}

# Readiness is written only after all programs and systemd units are ready.
python3 - "$ROOT/data/host-updater-ready.json" "$ROOT" "$UNIT" "$VERSION" <<'PY'
import json
import os
from pathlib import Path
import sys
import tempfile

destination, root, unit, version = sys.argv[1:]
directory = Path(destination).parent
fd, temporary = tempfile.mkstemp(dir=directory, prefix=".host-updater-ready-")
with os.fdopen(fd, "w", encoding="utf-8") as output:
    json.dump({"mode": "native-host-service",
               "project_dir": root,
               "unit": unit,
               "component_version": version,
               "protocol": 1,
               "maintenance": "automatic",
               "host_hostname": os.uname().nodename}, output)
    output.write("\n")
os.chmod(temporary, 0o644)
os.replace(temporary, destination)
PY

echo "Native updater installed: $UNIT.path"
echo "Self-maintenance enabled: $UNIT-maintenance.timer"
echo "No external Docker containers are involved."
