# Pinned Go standard-library security rebuild for v1.8.0-beta.11.
# This layer is necessary: the beta.10 image being overlaid contains Go 1.27.3.
FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine AS patched-controlplane
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
WORKDIR /src
COPY controlplane/go.mod ./
COPY controlplane/*.go ./
RUN CGO_ENABLED=0 go test ./...
RUN set -eux; \
    if [ "$TARGETARCH" = "arm" ] && [ -n "${TARGETVARIANT:-}" ]; then export GOARM="${TARGETVARIANT#v}"; fi; \
    CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags="-s -w" -o /out/npm-improved-control-plane .; \
    go version -m /out/npm-improved-control-plane | grep -F 'go1.27.4'

# Incremental beta release overlay; the caller provides the exact verified base.
# Caller MUST provide checksum-verified, architecture-specific OCI build
# contexts for npmi_host_base (builder architecture) and npmi_target_base.
# Do not use public floating tags or Docker daemon-wide builder settings.
# Build the frontend with the same pinned Node/Yarn toolchain that passes
# beta security CI, independently of the inherited application image. The
# image inherited from beta.10 is a runtime, not a reproducible build SDK.
FROM --platform=$BUILDPLATFORM node:24.22.1-bookworm AS frontend-builder
ENV NODE_ENV=development NODE_OPTIONS=--openssl-legacy-provider
WORKDIR /build/frontend
COPY frontend/package.json frontend/yarn.lock ./
RUN test "$(node -v)" = 'v24.22.1' \
    && test "$(yarn --version)" = '1.22.22' \
    && yarn install --frozen-lockfile --non-interactive --network-timeout 180000
COPY frontend/ ./
# IntlProvider imports generated language JSON; generate it before Vitest
# starts Vite's TypeScript checker. The production build also recompiles it.
RUN yarn locale-compile
# Run the critical unified-firewall UI and navigation regressions before
# publishing an image. TypeScript and production bundling follow.
RUN yarn vitest run src/pages/Settings/Firewall.test.ts src/modules/instanceFirewallVisibility.test.ts src/hooks/useReleaseChannel.test.tsx src/modules/copyText.test.ts
RUN yarn build

FROM npmi_target_base AS npmi_runtime
ARG BUILD_VERSION
ARG BUILD_COMMIT
ARG BUILD_DATE
ENV NPM_BUILD_VERSION="${BUILD_VERSION}" \
    NPM_BUILD_COMMIT="${BUILD_COMMIT}" \
    NPM_BUILD_DATE="${BUILD_DATE}"
# Replace the older beta control plane with the patched binary from this
# exact source commit. Restore the bind capability after COPY, and verify it.
COPY --from=patched-controlplane /out/npm-improved-control-plane /usr/local/bin/npm-improved-control-plane
RUN set -eux; \
    setcap 'cap_net_bind_service=+ep' /usr/local/bin/npm-improved-control-plane; \
    getcap /usr/local/bin/npm-improved-control-plane | grep -F cap_net_bind_service; \
    grep -a -q 'go1.27.4' /usr/local/bin/npm-improved-control-plane
WORKDIR /app
COPY backend/ /app/
COPY --from=frontend-builder /build/frontend/dist/ /app/frontend/
COPY docker/rootfs/etc/s6-overlay/s6-rc.d/prepare/20-paths.sh /etc/s6-overlay/s6-rc.d/prepare/20-paths.sh
COPY docker/rootfs/etc/s6-overlay/s6-rc.d/prepare/30-ownership.sh /etc/s6-overlay/s6-rc.d/prepare/30-ownership.sh

RUN set -eux; \
    node --check /app/internal/instance-sync.js; \
    node --check /app/routes/cluster.js; \
    node --check /app/lib/npmx.js; \
    node --check /app/lib/npmx-legacy-bridge.js; \
    node --check /app/lib/npmx-version-alignment.js; \
    node --check /app/internal/update-manager.js; \
    test "$(node -p 'process.versions.node')" = '24.22.1'; \
    /usr/sbin/nginx -v 2>&1 | grep -F 'nginx/1.31.8'; \
    grep -a -q 'go1.27.4' /usr/local/bin/npm-improved-control-plane; \
    node --test /app/test/release-versions.test.js /app/test/update-channels.test.js /app/test/instance-security-policy.test.js /app/test/instance-network-observation.test.js /app/test/npmx-cluster-database.test.js /app/test/npmx-update-identity.test.js /app/test/npmx.test.js /app/test/npmx-peer-state.test.js /app/test/npmx-reconnect.test.js /app/test/npmx-legacy-bridge.test.js /app/test/npmx-version-alignment.test.js
LABEL org.opencontainers.image.title="NPM Improved" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.opencontainers.image.revision="${BUILD_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/gigabytegrove/npm-improved"
