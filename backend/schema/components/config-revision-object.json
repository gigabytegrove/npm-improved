{
	"type": "object",
	"description": "Durable configuration revision recorded by NPM Improved",
	"required": [
		"id",
		"created_on",
		"modified_on",
		"user_id",
		"object_type",
		"object_id",
		"operation",
		"status",
		"meta"
	],
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"created_on": {
			"$ref": "../common.json#/properties/created_on"
		},
		"modified_on": {
			"$ref": "../common.json#/properties/modified_on"
		},
		"user_id": {
			"type": "integer",
			"minimum": 0
		},
		"object_type": {
			"type": "string",
			"enum": [
				"proxy_host",
				"redirection_host",
				"dead_host",
				"stream"
			]
		},
		"object_id": {
			"type": "integer",
			"minimum": 1
		},
		"operation": {
			"type": "string",
			"enum": [
				"baseline",
				"create",
				"update",
				"enable",
				"disable",
				"delete",
				"restore"
			]
		},
		"status": {
			"type": "string",
			"enum": [
				"pending",
				"active",
				"superseded",
				"failed"
			]
		},
		"config_text": {
			"type": "string",
			"description": "Generated Nginx configuration. Included by the single-revision endpoint."
		},
		"snapshot": {
			"type": "object",
			"additionalProperties": true,
			"description": "Stored database snapshot. Included by the single-revision endpoint."
		},
		"error_text": {
			"type": [
				"string",
				"null"
			]
		},
		"meta": {
			"type": "object",
			"additionalProperties": true
		},
		"user": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"$ref": "./user-object.json"
				}
			]
		}
	}
}
