# NPM Improved Docker deployment
# Copy this file to .env and edit values before starting the stack.

TZ=Etc/UTC

# Host ports. Container ports remain 80/81/443.
HTTP_PORT=80
ADMIN_PORT=81
HTTPS_PORT=443

# Optional runtime settings.
DISABLE_IPV6=false
NPM_BUILD_VERSION=local

# Optional first-user bootstrap. Leave blank to use the interactive setup flow.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional encrypted scheduled backups.
# NPM_BACKUP_PASSPHRASE=
# NPM_BACKUP_SCOPE=disaster-recovery
# NPM_BACKUP_INTERVAL_HOURS=24
# NPM_BACKUP_RETENTION=7

# MySQL / MariaDB deployment values used by compose.mysql.yaml.
MYSQL_DATABASE=npm
MYSQL_USER=npm
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# PostgreSQL deployment values used by compose.postgres.yaml.
POSTGRES_DB=npm
POSTGRES_USER=npm
POSTGRES_PASSWORD=CHANGE_ME
